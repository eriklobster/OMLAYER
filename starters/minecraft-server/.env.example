# Copy to .env; do not commit .env.
# Accept https://www.minecraft.net/en-us/eula before setting TRUE.
EULA=FALSE
RCON_PASSWORD=
MC_VERSION=26.3
MC_MEMORY=2304M
MAX_PLAYERS=6
VIEW_DISTANCE=6
SIMULATION_DISTANCE=4
# Local-only first boot. For LAN set to the host's LAN IPv4 address.
BIND_IP=127.0.0.1
